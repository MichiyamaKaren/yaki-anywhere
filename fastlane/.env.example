# Copy to fastlane/.env (Git-ignored). Paths are relative to the repository root.
# Debug APKs always use .tools/android/yaki-anywhere-debug.keystore.
# Create a production upload key with Android Studio's Generate Signed Bundle / APK.
ANDROID_KEYSTORE_FILE=.tools/android/yaki-upload.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=

# Optional: Play Console service account with access to this application.
GOOGLE_PLAY_JSON_KEY=.tools/android/google-play-service-account.json
